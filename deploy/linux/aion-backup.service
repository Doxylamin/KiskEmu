# A verified backup of the realm and every world database on this machine into /var/lib/aion/backups, then the
# retention (tools/postgres_dev.py scheduled-backup). Started by aion-backup.timer; install.sh fills in @PG_BIN@.
# Retention (and AION_PG_TIMEOUT for large databases) in /etc/aion/local.env: AION_BACKUP_KEEP_DAILY (default 7),
# AION_BACKUP_KEEP_WEEKLY (default 4). Outcome: journalctl -u aion-backup, /var/lib/aion/backups/last-scheduled.json.
[Unit]
Description=AION2 database backup (verified)
Requires=aion-postgres.service
After=aion-postgres.service

[Service]
Type=oneshot
User=aion
Group=aion
Environment=AION_PG_HOME=/var/lib/aion/postgres AION_PG_BIN=@PG_BIN@
EnvironmentFile=-/etc/aion/local.env
ExecStart=/usr/bin/python3 /opt/aion/src/tools/postgres_dev.py scheduled-backup /var/lib/aion/backups
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/aion
UMask=0027
