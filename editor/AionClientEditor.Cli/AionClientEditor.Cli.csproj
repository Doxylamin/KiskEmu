<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>AionClientEditor.Cli</RootNamespace>
    <AssemblyName>kisk-client-tool</AssemblyName>
    <Description>Headless client table tool: schema dumps and custom NPC patch paks.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AionClientEditor.Core/AionClientEditor.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.Memory" Version="9.0.22" />
  </ItemGroup>
</Project>
